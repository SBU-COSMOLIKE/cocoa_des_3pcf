# Compile the joint shear two-point and three-point native interface.
# ROOTDIR is Cocoa/, and CONDA_PREFIX selects the existing environment.
# No package installation or network access is part of this Makefile.
.DEFAULT_GOAL := all
ROOTDIR ?= $(abspath ../../..)
PYTHON ?= python3
ifneq ($(strip $(C_COMPILER)),)
CC := $(C_COMPILER)
endif
ifneq ($(strip $(CXX_COMPILER)),)
CXX := $(CXX_COMPILER)
endif

SYSTEM := $(shell uname -s)
CORE := $(ROOTDIR)/external_modules/code/cosmolike_core
SOURCE := $(CORE)/cosmolike/3pcf
TARGET := cosmolike_des_3pcf_interface.so
BUILD := .build/strict

CPPFLAGS += -I$(ROOTDIR)/.local/include -I$(CORE)
CPPFLAGS += -I$(CONDA_PREFIX)/include
CPPFLAGS += -I$(ROOTDIR)/external_modules/code/simde
PYBIND_FLAGS := $(shell $(PYTHON) -m pybind11 --includes)
NUMPY_INCLUDE := $(shell $(PYTHON) -c \
    "import numpy; print(numpy.get_include())")
CPPFLAGS += -I$(NUMPY_INCLUDE)
STRICT := -fno-fast-math -fno-associative-math
STRICT += -frounding-math -ftrapping-math
COMMON := -fPIC -fopenmp $(STRICT)

ifdef COSMOLIKE_AGGRESSIVE_MODE
$(error COSMOLIKE_AGGRESSIVE_MODE is retired; use strict IEEE flags)
endif

ifdef COSMOLIKE_DEBUG_MODE
BUILD := .build/debug
COMMON += -O0 -g -Wall -Wextra
COMMON += -fsanitize=undefined,float-divide-by-zero
COMMON += -fno-sanitize-recover=all
else
COMMON += -O3 -march=native
endif

CFLAGS += -std=gnu99 $(COMMON)
CXXFLAGS += -std=c++23 $(COMMON) $(PYBIND_FLAGS)
LDFLAGS += -L$(ROOTDIR)/.local/lib -L$(CONDA_PREFIX)/lib
LDFLAGS += -Wl,-rpath,$(ROOTDIR)/.local/lib
LDFLAGS += -Wl,-rpath,$(CONDA_PREFIX)/lib
LDLIBS += -lgsl -lgslcblas -larmadillo -lopenblas -lfftw3 -lhdf5
LDLIBS += $(ROOTDIR)/.local/lib/libspdlog.a -lm

ifeq ($(SYSTEM),Darwin)
SOFLAGS := -dynamiclib -undefined dynamic_lookup
COMMON += -Wno-pass-failed -fno-reciprocal-math
else
SOFLAGS := -shared
COMMON += -fsignaling-nans
endif

OBJECTS := $(BUILD)/aperture_3pcf.o $(BUILD)/covariance_3pcf.o
OBJECTS += $(BUILD)/threepcf_wrapper.o $(BUILD)/threepcf_interface.o
OBJECTS += $(BUILD)/physics_3pcf.o $(BUILD)/physics_reference_3pcf.o
OBJECTS += $(BUILD)/feedback_3pcf.o
OBJECTS += $(BUILD)/physics_grid_3pcf.o
OBJECTS += $(BUILD)/physics_wrapper.o $(BUILD)/physics_interface.o
OBJECTS += $(BUILD)/coupling_3pcf.o $(BUILD)/fftlog_3pcf.o
OBJECTS += $(BUILD)/transform_3pcf.o
OBJECTS += $(BUILD)/transform_wrapper.o $(BUILD)/transform_interface.o
OBJECTS += $(BUILD)/covariance_physics_3pcf.o
OBJECTS += $(BUILD)/covariance_wrapper.o $(BUILD)/covariance_interface.o
OBJECTS += $(BUILD)/basics.o $(BUILD)/structs.o $(BUILD)/log.o
OBJECTS += $(BUILD)/threepcf_core_bridge.o
OBJECTS += $(BUILD)/halo_profile.o $(BUILD)/cosmo3D.o $(BUILD)/baryons.o
OBJECTS += $(BUILD)/interface.o


# The ordinary two-point prediction uses the same native state.
OBJECTS += $(BUILD)/bias.o $(BUILD)/cosmo2D.o $(BUILD)/cosmo2D_scuts.o
OBJECTS += $(BUILD)/halo.o $(BUILD)/IA.o $(BUILD)/radial_weights.o
OBJECTS += $(BUILD)/redshift_spline.o $(BUILD)/pt_cfastpt.o
OBJECTS += $(BUILD)/generic_interface.o $(BUILD)/cosmo2D_wrapper.o
OBJECTS += $(BUILD)/cosmo2D_scuts_wrapper.o $(BUILD)/halo_wrapper.o
OBJECTS += $(BUILD)/cfastpt.o $(BUILD)/utils_cfastpt.o $(BUILD)/utils_complex_cfastpt.o

$(BUILD)/bias.o: $(CORE)/cosmolike/bias.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/cosmo2D.o: $(CORE)/cosmolike/cosmo2D.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/cosmo2D_scuts.o: $(CORE)/cosmolike/cosmo2D_scuts.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/halo.o: $(CORE)/cosmolike/halo.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/IA.o: $(CORE)/cosmolike/IA.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/radial_weights.o: $(CORE)/cosmolike/radial_weights.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/redshift_spline.o: $(CORE)/cosmolike/redshift_spline.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/pt_cfastpt.o: $(CORE)/cosmolike/pt_cfastpt.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/generic_interface.o: $(CORE)/cosmolike/generic_interface.cpp | $(BUILD)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/cosmo2D_wrapper.o: $(CORE)/cosmolike/cosmo2D_wrapper.cpp | $(BUILD)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/cosmo2D_scuts_wrapper.o: $(CORE)/cosmolike/cosmo2D_scuts_wrapper.cpp | $(BUILD)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/halo_wrapper.o: $(CORE)/cosmolike/halo_wrapper.cpp | $(BUILD)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/cfastpt.o: $(ROOTDIR)/external_modules/code/cfastpt/cfastpt.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/utils_cfastpt.o: $(ROOTDIR)/external_modules/code/cfastpt/utils_cfastpt.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/utils_complex_cfastpt.o: $(ROOTDIR)/external_modules/code/cfastpt/utils_complex_cfastpt.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

.PHONY: all clean FORCE
all: $(TARGET)

# Relink the selected mode even when a different mode's extension is
# newer than this mode's objects. Object directories keep both apart.
FORCE:

$(BUILD):
	mkdir -p $(BUILD)

$(BUILD)/%.o: $(SOURCE)/%.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/%.o: $(SOURCE)/%.cpp | $(BUILD)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/interface.o: interface.cpp | $(BUILD)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@

# Core translation units outside the 3pcf directory: basics.c carries the
# shared allocators, log.c the shared error reporter, and structs.c the
# globals basics.c references (the module loader needs every data symbol
# resolved). All compile with the same strict flags as the sources above.
$(BUILD)/basics.o: $(CORE)/cosmolike/basics.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/structs.o: $(CORE)/cosmolike/structs.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/log.o: $(CORE)/log.c/src/log.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

# The shared NFW and variance readers resolve inside this extension.
# cosmo3D also references the baryon reader, whose file input uses HDF5.
# These dependencies must not come from another project's loaded module.
$(BUILD)/halo_profile.o: $(CORE)/cosmolike/halo_profile.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/cosmo3D.o: $(CORE)/cosmolike/cosmo3D.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/baryons.o: $(CORE)/cosmolike/baryons.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

$(TARGET): $(OBJECTS) FORCE
	$(CXX) $(COMMON) $(SOFLAGS) $(OBJECTS) $(LDFLAGS) $(LDLIBS) -o $@

# Only artifacts owned by this target are removed.
clean:
	rm -f $(TARGET) $(OBJECTS) $(OBJECTS:.o=.d)

-include $(OBJECTS:.o=.d)
