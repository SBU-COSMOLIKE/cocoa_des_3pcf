# Case 5: synthetic TATT data vector with an independent-pilot compression and the Percival likelihood (a teaching configuration).
# Run EXAMPLE_COMPRESSION.ipynb to create the fixed independent-pilot matrix; all 480 rows enter before the compression.
# Ns = 796 independent Gaussian mocks is an explicit approximation; no Hartlap or PME correction.
# Source n(z): the recorded demonstration processing of the released nz_source table (0.04 per cent of the bin-1 area clipped).
# Priors differ from the published analysis by design: 10^9 A_s sampled uniformly (sigma8 derived), mnu = 0.06 fixed.
# scripts/convert_desy3_fits.py writes every data/ input named here from the released FITS files.

data_file = des_y3_tatt_synthetic.datavector
mask_file =
compression_file = ../chains/independent_pilot_compression.npz
mock_count = 796
parameter_count = 18
source_ntomo = 4
n_theta = 20
theta_min_arcmin = 2.5
theta_max_arcmin = 250.0
map3_radii_arcmin = 7.0 14.0 25.0 40.0
nz_source_file = des_y3_source.nz
nz_source_bin_width = 0.01
cov_file = des_y3_joint.cov
